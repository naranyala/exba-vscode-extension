{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "Run Web Component Dashboard",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceRoot}"
			],
			"outFiles": [
				"${workspaceRoot}/dist/**/*.js"
			],
			"sourceMaps": true,
			"preLaunchTask": "bun: build"
		}
	]
}
