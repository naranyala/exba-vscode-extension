{
	"name": "wasm-webcomponent-webview-sample",
	"description": "A custom browser-native Web Component framework utilizing a Rust-WASM core engine.",
	"author": "Microsoft Corporation",
	"license": "MIT",
	"version": "1.0.0",
	"publisher": "vscode-samples",
	"categories": [],
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "vscode-samples.wasm-webcomponent-webview.show",
				"category": "Samples",
				"title": "WASM Web Component: Show Dashboard"
			}
		]
	},
	"devDependencies": {
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"esbuild": "^0.25.0",
		"typescript": "^5.9.2"
	},
	"scripts": {
		"vscode:prepublish": "bun run build",
		"build": "node ./bin/esbuild.js && cargo build --target wasm32-unknown-unknown"
	}
}
